# Daily Stock Magazine - Environment Variables Template
# Copy this file to .env and fill in your values manually
# NEVER commit .env to GitHub!

# ============================================
# GITHUB CONFIGURATION (Required)
# ============================================

# GitHub Personal Access Token
# Get it from: https://github.com/settings/tokens
# Scopes needed: repo (full control of private repositories)
# This is used by GitHub Actions to auto-commit & push
GITHUB_TOKEN=***

# GitHub Repository URL
# Format: https://github.com/USERNAME/REPO.git
GITHUB_REPO_URL=https://github.com/ArikGarbuz/DailyStockMagazine.git

# Git User Configuration
GIT_USER_EMAIL=arikgarbuz@gmail.com
GIT_USER_NAME=Arik Garbuz

# ============================================
# TELEGRAM CONFIGURATION (Optional)
# ============================================

# Telegram Bot Token
# Get it from: @BotFather on Telegram
# Only needed if you want daily notifications
TELEGRAM_BOT_TOKEN=*

# Telegram Chat ID (your personal ID or channel)
# Get it from: @userinfobot on Telegram
# Only needed if you want daily notifications
TELEGRAM_CHAT_ID=**

# ============================================
# SCHEDULER CONFIGURATION
# ============================================

# Run time (24-hour format, Israel timezone)
SCHEDULE_TIME=16:20

# Days to run (1=Monday, 5=Friday)
SCHEDULE_DAYS=1-5

# ============================================
# SAFETY CHECKLIST
# ============================================

# Confirm you understand security:
# - This .env file should NEVER be committed to GitHub
# - Keep GITHUB_TOKEN secret - it has repo access
# - Add .env to .gitignore
SECURITY_CONFIRMED=false

# ============================================
# DO NOT SHARE YOUR .env FILE
# ============================================
