# ================================================
# VERCEL + NEXT.JS - DAILY STOCK MAGAZINE SITE
# ================================================
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to GitHub!

# ================================================
# GITHUB CONFIGURATION (Required)
# ================================================

# GitHub Personal Access Token (already have)
# Get it from: https://github.com/settings/tokens
# Scopes: repo (full control of private repositories)
GITHUB_TOKEN=ghp_***

# GitHub Repository URL
GITHUB_REPO_URL=https://github.com/ArikGarbuz/DailyStockMagazine.git

# Git User Configuration
GIT_USER_EMAIL=arikgarbuz@gmail.com
GIT_USER_NAME=Arik Garbuz

# ================================================
# VERCEL CONFIGURATION (Required for hosting)
# ================================================

# Vercel API Token
# Get it from: https://vercel.com/account/tokens
# Create a new token with "Full Access"
VERCEL_TOKEN=***

# Vercel Organization ID
# Find at: https://vercel.com/account/settings
# Looks like: "team_xxxxxxxxxxxxxx" or your username
VERCEL_ORG_ID=***

# Vercel Project ID (auto-generated after first deploy)
# Leave empty first time, fill after deployment
VERCEL_PROJECT_ID=***

# ================================================
# STOCK DATA API (Required for live prices/news)
# ================================================

# Finnhub API Key (free tier: 60 calls/min)
# Get it from: https://finnhub.io/dashboard (free signup, no card)
# Must also be added as an Environment Variable in Vercel project settings
FINNHUB_API_KEY=***

# ================================================
# NEXT.JS CONFIGURATION
# ================================================

# Site URL (used in meta tags)
NEXT_PUBLIC_SITE_URL=https://dailystockmagazine.vercel.app

# Site Name
NEXT_PUBLIC_SITE_NAME=Daily Stock Magazine

# ================================================
# NOTIFICATION CONFIGURATION (Optional)
# ================================================

# Telegram Bot Token (for daily notifications)
# Get it from: @BotFather on Telegram
# Leave empty if you don't want notifications
TELEGRAM_BOT_TOKEN=***

# Telegram Chat ID (your personal ID)
# Get it from: @userinfobot on Telegram
TELEGRAM_CHAT_ID=***

# Email Configuration (for newsletter - optional)
# Gmail example: use "App Password" not regular password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# Recipient email for daily digest
NEWSLETTER_EMAIL=your-email@gmail.com

# ================================================
# SCHEDULER CONFIGURATION
# ================================================

# Run time (24-hour format, Israel timezone)
SCHEDULE_TIME=16:20

# Days to run (1=Monday, 5=Friday)
SCHEDULE_DAYS=1-5

# ================================================
# DATA CONFIGURATION
# ================================================

# Number of stocks to display
STOCKS_COUNT=15

# Minimum market cap threshold (in billions)
MIN_MARKET_CAP=0.5

# Stock price range (only stocks under this price)
MAX_STOCK_PRICE=30

# ================================================
# FEATURE FLAGS
# ================================================

# Enable bilingual (English + Hebrew)
ENABLE_BILINGUAL=true

# Enable dark theme (default)
ENABLE_DARK_THEME=true

# Enable mobile responsive design
ENABLE_RESPONSIVE=true

# ================================================
# SECURITY & MONITORING
# ================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable error tracking (Sentry - optional)
SENTRY_DSN=***

# ================================================
# SAFETY CHECKLIST
# ================================================

# Confirm you understand security:
# - This .env.local file should NEVER be committed
# - Keep GITHUB_TOKEN and VERCEL_TOKEN secret
# - Add .env.local to .gitignore
# - Regenerate tokens if exposed
SECURITY_CONFIRMED=false

# ================================================
# DO NOT SHARE YOUR .env.local FILE
# ================================================
# It contains your personal API tokens!
# Anyone with this file can:
# - Modify your GitHub repository
# - Modify your Vercel project
# - Send messages via your Telegram bot
# - Send emails from your account
#
# KEEP IT SECRET!
